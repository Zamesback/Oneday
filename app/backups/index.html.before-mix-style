      </div>
    </div>

    <!-- AI 对话 -->
    <div class="view" id="view-chat">
      <div class="chat-container">
        <div class="chat-messages" id="chat-messages"></div>
        <div class="chat-input-area">
          <div class="chat-input-wrap">
            <textarea class="chat-input" id="chat-input" placeholder="跟我说说今天吧..." onkeydown="handleChatKeydown(event)"></textarea>
            <button class="chat-send" id="chat-send" onclick="sendChat()">发送</button>
          </div>
          <div class="chat-hint">说"我要做XX"自动记待办 · 说"想到XX"自动记灵感 · 提到人名自动草记到朋友</div>
        </div>
      </div>
    </div>

    <!-- 设置 -->
    <div class="view" id="view-settings">
      <div class="page">
        <div class="page-header">
          <div class="page-eyebrow">SETTINGS</div>
          <h2 class="page-title">设置</h2>
        </div>

        <div class="settings-section">
          <h3>个人</h3>
          <div class="settings-item">
            <div>
              <div class="settings-label">你的名字</div>
              <div class="settings-desc">AI 会用这个名字称呼你</div>
            </div>
            <div class="settings-control">
              <input type="text" id="set-userName" placeholder="怎么称呼你？">
            </div>
          </div>
        </div>

        <div class="settings-section">
          <h3>定时提醒</h3>
          <div class="settings-item">
            <div>
              <div class="settings-label">早间问候</div>
              <div class="settings-desc">每天这个时间 AI 跟你说早上好</div>
            </div>
            <div class="settings-control">
              <input type="time" id="set-morningTime" value="07:30">
            </div>
          </div>
          <div class="settings-item">
            <div>
              <div class="settings-label">晚间总结</div>
              <div class="settings-desc">每天这个时间提醒你聊聊今天</div>
            </div>
            <div class="settings-control">
              <input type="time" id="set-eveningTime" value="22:00">
            </div>
          </div>
          <div class="settings-item">
            <div>
              <div class="settings-label">运动提醒</div>
              <div class="settings-desc">没打卡的话这个时间提醒你</div>
            </div>
            <div class="settings-control">
              <input type="time" id="set-exerciseReminderTime" value="20:00">
            </div>
          </div>
          <div class="settings-item">
            <div>
              <div class="settings-label">启用系统通知</div>
              <div class="settings-desc">通过 macOS 系统通知提醒</div>
            </div>
            <div class="settings-control">
              <select id="set-notificationsEnabled">
                <option value="true">启用</option>
                <option value="false">关闭</option>
              </select>
            </div>
          </div>
        </div>

        <div class="settings-section">
          <h3>AI 配置</h3>
          <div class="settings-item">
            <div>
              <div class="settings-label">AI 服务商</div>
              <div class="settings-desc">选择大模型服务商</div>
            </div>
            <div class="settings-control">
              <select id="set-apiProvider">
                <option value="deepseek">DeepSeek</option>
                <option value="doubao">豆包</option>
                <option value="mock">模拟模式</option>
              </select>
            </div>
          </div>
          <div class="settings-item">
            <div>
              <div class="settings-label">API Key</div>
              <div class="settings-desc">配置后启用真实 AI 对话</div>
            </div>
            <div class="settings-control">
              <input type="password" id="set-apiKey" placeholder="sk-...">
            </div>
          </div>
          <div class="settings-item">
            <div>
              <div class="settings-label">AI 风格</div>
              <div class="settings-desc">AI 回应的语气风格</div>
            </div>
            <div class="settings-control">
              <select id="set-aiStyle">
                <option value="encouraging">鼓励型</option>
                <option value="calm">冷静型</option>
                <option value="humorous">幽默型</option>
              </select>
            </div>
          </div>
        </div>

        <div class="settings-section">
          <h3>数据</h3>
          <div class="settings-item">
            <div>
              <div class="settings-label">测试通知</div>
              <div class="settings-desc">发送一条测试系统通知</div>
            </div>
            <div class="settings-control">
              <button class="btn btn-sm" onclick="testNotification()">测试</button>
            </div>
          </div>
          <div class="settings-item">
            <div>
              <div class="settings-label">保存设置</div>
              <div class="settings-desc">保存以上所有配置</div>
            </div>
            <div class="settings-control">
              <button class="btn btn-sm btn-primary" onclick="saveSettings()">保存</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- 抽屉 -->
<div class="drawer-overlay" id="drawer-overlay" onclick="closeDrawer()"></div>
<div class="drawer" id="drawer">
  <span class="drawer-close" onclick="closeDrawer()">×</span>
  <div class="drawer-title" id="drawer-title">详情</div>
  <div id="drawer-content"></div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
// ===== OneDay 前端核心 =====
const API_BASE = 'http://localhost:8765/api';
let _data = null;
let _currentView = 'splash';
let _friendsTab = 'list';

// ===== 工具函数 =====
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}

function formatDate(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

function formatDateTime(iso) {
  if (!iso) return '';
  const d = new Date(iso);
  return `${d.getMonth()+1}月${d.getDate()}日 ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}

function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

// ===== 数据管理 =====
async function loadData() {
  try {
    const res = await fetch(API_BASE + '/work-data');
    _data = await res.json();
    return _data;
  } catch (e) {
    console.error('加载数据失败', e);
    showToast('连接后端失败');
    return null;
  }
}

async function saveData() {
  if (!_data) return;
  try {
    await fetch(API_BASE + '/work-data', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(_data)
    });
  } catch (e) {
    console.error('保存失败', e);
  }
}

async function apiPost(module, data) {
  const res = await fetch(`${API_BASE}/${module}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
  return res.json();
}

async function apiPut(module, id, data) {
  const res = await fetch(`${API_BASE}/${module}/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
  return res.json();
}

async function apiDelete(module, id) {
  await fetch(`${API_BASE}/${module}/${id}`, { method: 'DELETE' });
}

// ===== 路由 =====
function navigate(view) {
  _currentView = view;
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-' + view).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.querySelector(`.nav-item[data-view="${view}"]`)?.classList.add('active');
  renderView(view);
}

document.querySelectorAll('.nav-item').forEach(item => {
  item.addEventListener('click', () => navigate(item.dataset.view));
});

function renderView(view) {
  switch(view) {
    case 'splash': renderSplash(); break;
    case 'todos': renderTodos(); break;
    case 'projects': renderProjects(); break;
    case 'inspirations': renderInspirations(); break;
    case 'exercise': renderExercise(); break;
    case 'friends': renderFriends(); break;
    case 'chat': renderChat(); break;
    case 'settings': renderSettings(); break;
  }
}

// ===== 开屏页 =====
function renderSplash() {
  if (!_data) return;
  const wp = _data.wallpaper || {};
  const settings = _data.settings || {};
  const name = settings.userName || '';

  // 背景
  const bg = document.getElementById('splash-bg');
  // Demo：用生成的图片作为背景（后续接 AI 生成壁纸 API）
  const demoWallpaper = 'assets/wallpaper-demo.jpg';
  bg.style.backgroundImage = `url(${demoWallpaper})`;
  bg.classList.add('has-image');

  // 日期
  const now = new Date();
  const weekdays = ['周日','周一','周二','周三','周四','周五','周六'];
  document.getElementById('splash-date').textContent =
    `${now.getFullYear()}年${now.getMonth()+1}月${now.getDate()}日 · ${weekdays[now.getDay()]}`;

  // 问候
  const hour = now.getHours();
  let greeting = '';
  if (hour < 6) greeting = '夜深了';
  else if (hour < 12) greeting = '早上好';
  else if (hour < 14) greeting = '中午好';
  else if (hour < 18) greeting = '下午好';
  else greeting = '晚上好';
  if (name) greeting += `，${name}`;
  greeting += '。';
  document.getElementById('splash-greeting').textContent = greeting;

  // 每日一句
  document.getElementById('splash-quote').textContent = wp.quote || '复杂世界里，一个就够了。';

  // 统计
  const todos = _data.todos || [];
  const pending = todos.filter(t => t.status !== 'done').length;
  const projects = _data.projects || [];
  const active = projects.filter(p => p.status !== 'done' && p.status !== 'cancelled').length;
  const exercises = _data.exercises || [];
  const todayEx = exercises.filter(e => (e.date || '').startsWith(todayStr()) && e.status === 'done').length;

  document.getElementById('splash-stats').innerHTML = `
    <div class="splash-stat">
      <div class="splash-stat-num">${pending}</div>
      <div class="splash-stat-label">待办</div>
    </div>
    <div class="splash-stat">
      <div class="splash-stat-num">${active}</div>
      <div class="splash-stat-label">进行中</div>
    </div>
    <div class="splash-stat">
      <div class="splash-stat-num">${todayEx > 0 ? '✓' : '—'}</div>
      <div class="splash-stat-label">今日运动</div>
    </div>
  `;
}

// ===== 待办 =====
function renderTodos() {
  const list = document.getElementById('todo-list');
  const todos = (_data?.todos || []).slice().sort((a,b) => {
    if (a.status === 'done' && b.status !== 'done') return 1;
    if (a.status !== 'done' && b.status === 'done') return -1;
    return 0;
  });

  if (todos.length === 0) {
    list.innerHTML = '<div class="empty"><p>还没有待办。跟 AI 说"我要做XX"，或者上面添加。</p></div>';
    return;
  }

  list.innerHTML = todos.map(t => `
    <div class="todo-item">
      <div class="todo-check ${t.status === 'done' ? 'checked' : ''}" onclick="toggleTodo('${t.id}')">${t.status === 'done' ? '✓' : ''}</div>
      <div class="todo-content">
        <div class="todo-title ${t.status === 'done' ? 'done' : ''}">${t.title || ''}</div>
        <div class="todo-meta">
          ${t.priority === 'high' ? '<span class="tag tag-red">高优先级</span>' : ''}
          ${t.source === 'ai_extract' ? '<span>AI 提取</span>' : '<span>手动</span>'}
          <span>${formatDate(t.date)}</span>
        </div>
      </div>
      <span class="todo-delete" onclick="deleteTodo('${t.id}')">删除</span>
    </div>
  `).join('');
}

async function addTodo() {
  const input = document.getElementById('todo-input');
  const title = input.value.trim();
  if (!title) return;
  const item = await apiPost('todos', { title, priority: 'medium', status: 'pending', source: 'manual' });
  _data.todos.unshift(item);
  input.value = '';
  renderTodos();
  showToast('已添加');
}

async function toggleTodo(id) {
  const t = _data.todos.find(x => x.id === id);
  if (!t) return;
  t.status = t.status === 'done' ? 'pending' : 'done';
  await apiPut('todos', id, { status: t.status });
  renderTodos();
}

async function deleteTodo(id) {
  await apiDelete('todos', id);
  _data.todos = _data.todos.filter(t => t.id !== id);
  renderTodos();
}

// ===== 重要事件 =====
const PROJECT_STAGES = ['规划中', '跟进中', '已成交', '已完成', '已搁置'];
const PRIORITIES = [
  { value: 'high', label: '高' },
  { value: 'medium', label: '中' },
  { value: 'low', label: '低' },
];

function renderProjects() {
  const list = document.getElementById('project-list');
  const projects = _data?.projects || [];

  if (projects.length === 0) {
    list.innerHTML = '<div class="empty"><p>还没有重要事件。点击上方添加，或者跟 AI 聊聊。</p></div>';
    return;
  }

  list.innerHTML = projects.map(p => `
    <div class="card" onclick="openProjectDrawer('${p.id}')">
      <div class="card-title">${p.name || '未命名'}</div>
      <div class="card-meta">
        <span class="tag">${p.stage || '规划中'}</span>
        ${p.priority === 'high' ? '<span class="tag tag-red">高优先级</span>' : ''}
        ${p.customer ? `<span>${p.customer}</span>` : ''}
        ${p.amount ? `<span>¥${p.amount}</span>` : ''}
        ${p.deadline ? `<span>截止 ${formatDate(p.deadline)}</span>` : ''}
      </div>
      ${p.notes ? `<div style="font-size:12px;color:var(--text-secondary);margin-top:8px;">${p.notes.substring(0,80)}${p.notes.length>80?'...':''}</div>` : ''}
    </div>
  `).join('');
}

function openProjectDrawer(id) {
  const p = id ? _data.projects.find(x => x.id === id) : null;
  document.getElementById('drawer-title').textContent = p ? '编辑事件' : '新增事件';
  document.getElementById('drawer-content').innerHTML = `
    <div class="form-group">
      <label class="form-label">名称</label>
      <input class="form-input" id="pf-name" value="${p?.name || ''}" placeholder="事件名称">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">阶段</label>
        <select class="form-select" id="pf-stage">
          ${PROJECT_STAGES.map(s => `<option value="${s}" ${p?.stage===s?'selected':''}>${s}</option>`).join('')}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">优先级</label>
        <select class="form-select" id="pf-priority">
          ${PRIORITIES.map(pr => `<option value="${pr.value}" ${p?.priority===pr.value?'selected':''}>${pr.label}</option>`).join('')}
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">关联方/客户</label>
        <input class="form-input" id="pf-customer" value="${p?.customer || ''}">
      </div>
      <div class="form-group">
        <label class="form-label">金额</label>
        <input class="form-input" id="pf-amount" value="${p?.amount || ''}">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">截止日期</label>
      <input class="form-input" type="date" id="pf-deadline" value="${p?.deadline ? p.deadline.substring(0,10) : ''}">
    </div>
    <div class="form-group">
      <label class="form-label">下一步行动</label>
      <input class="form-input" id="pf-nextAction" value="${p?.nextAction || ''}">
    </div>
    <div class="form-group">
      <label class="form-label">备注</label>
      <textarea class="form-textarea" id="pf-notes">${p?.notes || ''}</textarea>
    </div>
    <div style="display:flex;gap:12px;margin-top:24px;">
      <button class="btn btn-primary" onclick="saveProject('${id || ''}')">保存</button>
      ${p ? '<button class="btn btn-red" onclick="deleteProject(\'' + id + '\')">删除</button>' : ''}
    </div>
  `;
  showDrawer();
}

async function saveProject(id) {
  const data = {
    name: document.getElementById('pf-name').value.trim(),
    stage: document.getElementById('pf-stage').value,
    priority: document.getElementById('pf-priority').value,
    customer: document.getElementById('pf-customer').value.trim(),
    amount: document.getElementById('pf-amount').value.trim(),
    deadline: document.getElementById('pf-deadline').value,
    nextAction: document.getElementById('pf-nextAction').value.trim(),
    notes: document.getElementById('pf-notes').value.trim(),
  };
  if (!data.name) { showToast('请填写名称'); return; }

  if (id) {
    await apiPut('projects', id, data);
    const idx = _data.projects.findIndex(p => p.id === id);
    if (idx >= 0) _data.projects[idx] = {..._data.projects[idx], ...data};
  } else {
    const item = await apiPost('projects', data);
    _data.projects.unshift(item);
  }
  closeDrawer();
  renderProjects();
  showToast('已保存');
}

async function deleteProject(id) {
  if (!confirm('确定删除这个事件？')) return;
  await apiDelete('projects', id);
  _data.projects = _data.projects.filter(p => p.id !== id);
  closeDrawer();
  renderProjects();
}

// ===== 灵感 =====
function renderInspirations() {
  const list = document.getElementById('insp-list');
  const insps = _data?.inspirations || [];

  if (insps.length === 0) {
    list.innerHTML = '<div class="empty"><p>还没有灵感。想到什么随手记，跟 AI 说也行。</p></div>';
    return;
  }

  list.innerHTML = insps.map(i => `
    <div class="card">
      <div class="card-title" style="font-weight:400;">${i.content || ''}</div>
      <div class="card-meta">
        ${i.source === 'ai_extract' ? '<span>AI 提取</span>' : '<span>手动</span>'}
        <span>${formatDateTime(i.date)}</span>
        <span style="margin-left:auto;cursor:pointer;color:var(--red);" onclick="deleteInspiration('${i.id}')">删除</span>
      </div>
    </div>
  `).join('');
}

async function addInspiration() {
  const input = document.getElementById('insp-input');
  const content = input.value.trim();
  if (!content) return;
  const item = await apiPost('inspirations', { content, source: 'manual' });
  _data.inspirations.unshift(item);
  input.value = '';
  renderInspirations();
  showToast('已记录');
}

async function deleteInspiration(id) {
  await apiDelete('inspirations', id);
  _data.inspirations = _data.inspirations.filter(i => i.id !== id);
  renderInspirations();
}

// ===== 运动 =====
function renderExercise() {
  const exercises = _data?.exercises || [];
  const today = todayStr();

  // 今日状态
  const todayEx = exercises.filter(e => (e.date || '').startsWith(today) && e.status === 'done');
  document.getElementById('exercise-today-status').textContent =
    todayEx.length > 0 ? `今天已运动 ✓（${todayEx.length}次）` : '今天还没运动';
  document.getElementById('exercise-today-date').textContent = today;

  // 统计
  const now = new Date();
  const weekStart = new Date(now);
  weekStart.setDate(now.getDate() - now.getDay());
  const weekStr = weekStart.toISOString().substring(0,10);
  const monthStr = today.substring(0,7);

  document.getElementById('stat-week').textContent =
    exercises.filter(e => e.status === 'done' && (e.date || '') >= weekStr).length;
  document.getElementById('stat-month').textContent =
    exercises.filter(e => e.status === 'done' && (e.date || '').startsWith(monthStr)).length;
  document.getElementById('stat-total').textContent =
    exercises.filter(e => e.status === 'done').length;

  // 最近记录
  const list = document.getElementById('exercise-list');
  const recent = exercises.slice(0, 10);
  if (recent.length === 0) {
    list.innerHTML = '<div class="empty"><p>还没有运动记录。点击上方打卡今天。</p></div>';
  } else {
    list.innerHTML = recent.map(e => `
      <div class="card">
        <div class="card-title">${e.detail || '运动打卡'}</div>
        <div class="card-meta">
          <span>${formatDate(e.date)}</span>
          ${e.status === 'done' ? '<span class="tag">已完成</span>' : '<span class="tag">未完成</span>'}
        </div>
      </div>
    `).join('');
  }
}

async function checkInExercise() {
  const item = await apiPost('exercises', { status: 'done', detail: '日常运动', date: new Date().toISOString() });
  _data.exercises.unshift(item);
  renderExercise();
  showToast('打卡成功！');
}

// ===== 朋友 =====
function switchFriendsTab(tab) {
  _friendsTab = tab;
  document.querySelectorAll('.friends-tab').forEach(t => t.classList.remove('active'));
  document.querySelector(`.friends-tab[data-tab="${tab}"]`).classList.add('active');
  document.getElementById('friends-list-view').style.display = tab === 'list' ? 'block' : 'none';
  document.getElementById('friends-graph-view').style.display = tab === 'graph' ? 'block' : 'none';
  if (tab === 'graph') renderGraph();
}

function renderFriends() {
  const list = document.getElementById('friend-list');
  const friends = _data?.friends || [];

  if (friends.length === 0) {
    list.innerHTML = '<div class="empty"><p>还没有朋友记录。跟 AI 聊天时提到人名，会自动草记在这里。</p></div>';
    return;
  }

  list.innerHTML = friends.map(f => `
    <div class="card ${f.status === 'draft' ? 'friend-draft' : ''}" onclick="openFriendDrawer('${f.id}')">
      <div class="card-title">${f.name || '未命名'}</div>
      <div class="card-meta">
        ${f.identity ? `<span>${f.identity}</span>` : ''}
        ${f.relationship ? `<span>${f.relationship}</span>` : ''}
        ${f.status === 'draft' ? '<span class="tag tag-red">待确认</span>' : ''}
      </div>
      ${f.notes ? `<div style="font-size:12px;color:var(--text-secondary);margin-top:6px;">${f.notes.substring(0,60)}${f.notes.length>60?'...':''}</div>` : ''}
    </div>
  `).join('');
}

function openFriendDrawer(id) {
  const f = id ? _data.friends.find(x => x.id === id) : null;
  document.getElementById('drawer-title').textContent = f ? '编辑朋友' : '添加朋友';
  document.getElementById('drawer-content').innerHTML = `
    <div class="form-group">
      <label class="form-label">姓名</label>
      <input class="form-input" id="ff-name" value="${f?.name || ''}">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">身份/职业</label>
        <input class="form-input" id="ff-identity" value="${f?.identity || ''}" placeholder="如：采购经理">
      </div>
      <div class="form-group">
        <label class="form-label">关系</label>
        <input class="form-input" id="ff-relationship" value="${f?.relationship || ''}" placeholder="如：客户、朋友、同事">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">联系方式</label>
      <input class="form-input" id="ff-contact" value="${f?.contact || ''}">
    </div>
    <div class="form-group">
      <label class="form-label">备注</label>
      <textarea class="form-textarea" id="ff-notes">${f?.notes || ''}</textarea>
    </div>
    <div style="display:flex;gap:12px;margin-top:24px;">
      <button class="btn btn-primary" onclick="saveFriend('${id || ''}')">保存</button>
      ${f ? '<button class="btn btn-red" onclick="deleteFriend(\'' + id + '\')">删除</button>' : ''}
    </div>
  `;
  showDrawer();
}

async function saveFriend(id) {
  const data = {
    name: document.getElementById('ff-name').value.trim(),
    identity: document.getElementById('ff-identity').value.trim(),
    relationship: document.getElementById('ff-relationship').value.trim(),
    contact: document.getElementById('ff-contact').value.trim(),
    notes: document.getElementById('ff-notes').value.trim(),
    status: 'confirmed',
  };
  if (!data.name) { showToast('请填写姓名'); return; }

  if (id) {
    await apiPut('friends', id, data);
    const idx = _data.friends.findIndex(f => f.id === id);
    if (idx >= 0) _data.friends[idx] = {..._data.friends[idx], ...data};
  } else {
    const item = await apiPost('friends', {...data, status: 'confirmed', source: 'manual'});
    _data.friends.unshift(item);
  }
  closeDrawer();
  renderFriends();
  showToast('已保存');
}

async function deleteFriend(id) {
  if (!confirm('确定删除？')) return;
  await apiDelete('friends', id);
  _data.friends = _data.friends.filter(f => f.id !== id);
  closeDrawer();
  renderFriends();
}

// ===== 关系图谱（简易力导向） =====
function renderGraph() {
  const friends = _data?.friends || [];
  const svg = document.getElementById('graph-svg');
  const container = document.getElementById('graph-container');
  const W = container.clientWidth;
  const H = 500;

  if (friends.length === 0) {
    svg.innerHTML = '<text x="' + (W/2) + '" y="' + (H/2) + '" text-anchor="middle" fill="#999" font-size="13">还没有朋友数据</text>';
    return;
  }

  // 节点
  const nodes = friends.map((f, i) => ({
    id: f.id,
    name: f.name,
    x: W/2 + (Math.random()-0.5)*200,
    y: H/2 + (Math.random()-0.5)*200,
    vx: 0, vy: 0,
    data: f,
  }));

  // 边（基于关系类型连接相同关系的人）
  const links = [];
  const relGroups = {};
  nodes.forEach(n => {
    const rel = n.data.relationship || '其他';
    if (!relGroups[rel]) relGroups[rel] = [];
    relGroups[rel].push(n);
  });
  Object.values(relGroups).forEach(group => {
    for (let i = 0; i < group.length; i++) {
      for (let j = i+1; j < group.length; j++) {
        links.push({ source: group[i], target: group[j] });
      }
    }
  });

  // 力导向模拟
  for (let iter = 0; iter < 200; iter++) {
    // 斥力
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i+1; j < nodes.length; j++) {
        const dx = nodes[i].x - nodes[j].x;
        const dy = nodes[i].y - nodes[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy) || 1;
        const force = 3000 / (dist * dist);
        nodes[i].vx += (dx/dist) * force;
        nodes[i].vy += (dy/dist) * force;
        nodes[j].vx -= (dx/dist) * force;
        nodes[j].vy -= (dy/dist) * force;
      }
    }
    // 引力（边）
    links.forEach(l => {
      const dx = l.target.x - l.source.x;
      const dy = l.target.y - l.source.y;
      const dist = Math.sqrt(dx*dx + dy*dy) || 1;
      const force = (dist - 120) * 0.01;
      l.source.vx += (dx/dist) * force;
      l.source.vy += (dy/dist) * force;
      l.target.vx -= (dx/dist) * force;
      l.target.vy -= (dy/dist) * force;
    });
    // 中心引力
    nodes.forEach(n => {
      n.vx += (W/2 - n.x) * 0.005;
      n.vy += (H/2 - n.y) * 0.005;
      n.vx *= 0.9;
      n.vy *= 0.9;
      n.x += n.vx;
      n.y += n.vy;
      n.x = Math.max(40, Math.min(W-40, n.x));
      n.y = Math.max(40, Math.min(H-40, n.y));
    });
  }

  // 渲染
  let html = '';
  links.forEach(l => {
    html += `<line class="graph-line" x1="${l.source.x}" y1="${l.source.y}" x2="${l.target.x}" y2="${l.target.y}"/>`;
  });
  nodes.forEach(n => {
    const isDraft = n.data.status === 'draft';
    html += `<g class="graph-node" onclick="openFriendDrawer('${n.id}')">
      <circle cx="${n.x}" cy="${n.y}" r="22" fill="${isDraft ? '#f5f5f5' : '#fff'}" stroke="${isDraft ? '#ccc' : '#1a1a1a'}" stroke-width="1.5"/>
      <text x="${n.x}" y="${n.y+4}" font-size="11">${n.name.substring(0,2)}</text>
      <text x="${n.x}" y="${n.y+38}" font-size="10" fill="#666">${n.name}</text>
    </g>`;
  });
  svg.innerHTML = html;
}

// ===== AI 对话 =====
function renderChat() {
  const container = document.getElementById('chat-messages');
  const chats = (_data?.chats || []).slice().reverse();

  if (chats.length === 0) {
    container.innerHTML = `
      <div style="text-align:center;padding:60px 20px;color:var(--text-muted);">
        <p style="font-size:15px;margin-bottom:8px;">跟我聊聊吧</p>
        <p style="font-size:12px;">说说今天做了什么，有什么想法，或者只是想找人说说话。</p>
      </div>`;
    return;
  }

  container.innerHTML = chats.map(c => `
    <div class="chat-msg ${c.role}">
      <div class="chat-bubble">${c.content || ''}</div>
      <div class="chat-time">${formatDateTime(c.timestamp)}</div>
    </div>
  `).join('');
  container.scrollTop = container.scrollHeight;
}

function handleChatKeydown(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendChat();
  }
}

async function sendChat() {
  const input = document.getElementById('chat-input');
  const btn = document.getElementById('chat-send');
  const message = input.value.trim();
  if (!message) return;

  input.value = '';
  btn.disabled = true;
  btn.textContent = '...';

  // 立即显示用户消息
  _data.chats.unshift({
    id: 'temp_' + Date.now(),
    role: 'user',
    content: message,
    timestamp: new Date().toISOString(),
  });
  renderChat();

  try {
    const res = await fetch(API_BASE + '/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, history: _data.chats.slice(0, 20) })
    });
    const result = await res.json();

    // 重新加载数据（后端可能自动创建了待办/灵感/朋友）
    await loadData();
    renderChat();

    if (result.extracted) {
      const ex = result.extracted;
      let hints = [];
      if (ex.todos?.length) hints.push(`${ex.todos.length}个待办`);
      if (ex.inspirations?.length) hints.push(`${ex.inspirations.length}个灵感`);
      if (ex.friends?.length) hints.push(`${ex.friends.length}个人名`);
      if (hints.length) showToast(`已自动记录：${hints.join('、')}`);
    }
  } catch (e) {
    showToast('发送失败');
  }

  btn.disabled = false;
  btn.textContent = '发送';
}

// ===== 设置 =====
function renderSettings() {
  const s = _data?.settings || {};
  document.getElementById('set-userName').value = s.userName || '';
  document.getElementById('set-morningTime').value = s.morningTime || '07:30';
  document.getElementById('set-eveningTime').value = s.eveningTime || '22:00';
  document.getElementById('set-exerciseReminderTime').value = s.exerciseReminderTime || '20:00';
  document.getElementById('set-notificationsEnabled').value = s.notificationsEnabled ? 'true' : 'false';
  document.getElementById('set-apiProvider').value = s.apiProvider || 'deepseek';
  document.getElementById('set-apiKey').value = s.apiKey || '';
  document.getElementById('set-aiStyle').value = s.aiStyle || 'encouraging';
}

async function saveSettings() {
  const settings = {
    userName: document.getElementById('set-userName').value.trim(),
    morningTime: document.getElementById('set-morningTime').value,
    eveningTime: document.getElementById('set-eveningTime').value,
    exerciseReminderTime: document.getElementById('set-exerciseReminderTime').value,
    notificationsEnabled: document.getElementById('set-notificationsEnabled').value === 'true',
    apiProvider: document.getElementById('set-apiProvider').value,
    apiKey: document.getElementById('set-apiKey').value.trim(),
    aiStyle: document.getElementById('set-aiStyle').value,
  };
  _data.settings = settings;
  await fetch(API_BASE + '/settings', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(settings)
  });
  showToast('设置已保存');
}

async function testNotification() {
  await fetch(API_BASE + '/notify/test', { method: 'POST' });
  showToast('已发送测试通知');
}

// ===== 抽屉 =====
function showDrawer() {
  document.getElementById('drawer-overlay').classList.add('show');
  document.getElementById('drawer').classList.add('show');
}
function closeDrawer() {
  document.getElementById('drawer-overlay').classList.remove('show');
  document.getElementById('drawer').classList.remove('show');
}

// ===== 初始化 =====
async function init() {
  await loadData();
  if (_data) {
    renderSplash();
    // 每 30 秒刷新数据
    setInterval(async () => {
      await loadData();
      if (_currentView !== 'chat') renderView(_currentView);
    }, 30000);
  }
}

init();
</script>
