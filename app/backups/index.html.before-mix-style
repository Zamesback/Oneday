<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OneDay / 一日</title>
<style>
/* ===== OneDay - One 一个风格 ===== */
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: #fafafa;
  --bg-card: #ffffff;
  --text: #1a1a1a;
  --text-secondary: #666666;
  --text-muted: #999999;
  --border: #e8e8e8;
  --accent: #1a1a1a;
  --red: #d4382e;
  --hover: #f5f5f5;
}
html, body {
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
input, textarea, select { font-family: inherit; font-size: inherit; }

/* ===== 布局 ===== */
.app { display: flex; height: 100vh; }

/* 侧边栏 */
.sidebar {
  width: 200px;
  background: #fff;
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}
.sidebar-logo {
  padding: 28px 24px 20px;
  border-bottom: 1px solid var(--border);
}
.sidebar-logo h1 {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 1px;
}
.sidebar-logo p {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
  letter-spacing: 2px;
}
.sidebar-nav { flex: 1; padding: 12px 0; overflow-y: auto; }
.nav-group { padding: 8px 0; }
.nav-group-title {
  padding: 6px 24px;
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 2px;
  text-transform: uppercase;
}
.nav-item {
  display: flex;
  align-items: center;
  padding: 9px 24px;
  font-size: 13px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.15s;
  border-left: 2px solid transparent;
}
.nav-item:hover { background: var(--hover); color: var(--text); }
.nav-item.active {
  color: var(--text);
  font-weight: 500;
  border-left-color: var(--red);
  background: var(--hover);
}
.nav-item .dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--red);
  margin-left: auto;
  display: none;
}
.nav-item.has-dot .dot { display: block; }
.sidebar-footer {
  padding: 16px 24px;
  border-top: 1px solid var(--border);
  font-size: 11px;
  color: var(--text-muted);
}

/* 主内容区 */
.main { flex: 1; overflow-y: auto; position: relative; }
.view { display: none; min-height: 100%; }
.view.active { display: block; }

/* ===== 开屏页（每日明信片） ===== */
.splash {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60px;
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
.splash::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.35);
}
.splash.has-image::before {
  background: linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0.35) 40%, rgba(255,255,255,0.5) 70%, rgba(255,255,255,0.75) 100%);
}
.splash-content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 600px;
  text-shadow: 0 1px 3px rgba(255,255,255,0.8), 0 0 20px rgba(255,255,255,0.5);
}
.splash-date, .splash-greeting, .splash-quote, .splash-stat-num, .splash-stat-label {
  text-shadow: 0 1px 4px rgba(255,255,255,0.9), 0 0 30px rgba(255,255,255,0.6);
}
.splash-content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 600px;
}
.splash-date {
  font-size: 13px;
  color: var(--text-secondary);
  letter-spacing: 4px;
  margin-bottom: 16px;
}
.splash-greeting {
  font-size: 32px;
  font-weight: 300;
  line-height: 1.5;
  margin-bottom: 24px;
  color: var(--text);
}
.splash-quote {
  font-size: 14px;
  color: var(--text-secondary);
  font-style: italic;
  margin-bottom: 48px;
  padding: 0 40px;
}
.splash-stats {
  display: flex;
  justify-content: center;
  gap: 48px;
  margin-bottom: 40px;
}
.splash-stat { text-align: center; }
.splash-stat-num {
  font-size: 28px;
  font-weight: 300;
  color: var(--text);
}
.splash-stat-label {
  font-size: 11px;
  color: var(--text-muted);
  letter-spacing: 1px;
  margin-top: 4px;
}
.splash-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
}
.btn {
  padding: 10px 28px;
  font-size: 13px;
  border: 1px solid var(--text);
  background: transparent;
  color: var(--text);
  transition: all 0.2s;
  letter-spacing: 1px;
}
.btn:hover { background: var(--text); color: #fff; }
.btn-primary { background: var(--text); color: #fff; }
.btn-primary:hover { background: #333; }
.btn-sm { padding: 6px 16px; font-size: 12px; }
.btn-red { border-color: var(--red); color: var(--red); }
.btn-red:hover { background: var(--red); color: #fff; }

/* ===== 通用页面 ===== */
.page { padding: 48px 56px; max-width: 960px; margin: 0 auto; }
.page-header { margin-bottom: 36px; }
.page-eyebrow {
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 3px;
  text-transform: uppercase;
  margin-bottom: 8px;
}
.page-title {
  font-size: 28px;
  font-weight: 300;
  letter-spacing: 1px;
}
.page-desc {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 8px;
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  padding: 20px 24px;
  margin-bottom: 12px;
  transition: all 0.2s;
  cursor: pointer;
}
.card:hover { border-color: var(--text-muted); }
.card-title {
  font-size: 15px;
  font-weight: 500;
  margin-bottom: 6px;
}
.card-meta {
  font-size: 12px;
  color: var(--text-muted);
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}
.tag {
  display: inline-block;
  padding: 2px 10px;
  font-size: 11px;
  border: 1px solid var(--border);
  color: var(--text-secondary);
}
.tag-red { border-color: var(--red); color: var(--red); }
.tag-done { text-decoration: line-through; color: var(--text-muted); }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80px 20px;
  color: var(--text-muted);
}
.empty p { font-size: 13px; margin-top: 8px; }

/* 表单 */
.form-group { margin-bottom: 20px; }
.form-label {
  display: block;
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 6px;
  letter-spacing: 1px;
}
.form-input, .form-textarea, .form-select {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--border);
  background: #fff;
  font-size: 13px;
  color: var(--text);
  outline: none;
  transition: border-color 0.2s;
}
.form-input:focus, .form-textarea:focus, .form-select:focus { border-color: var(--text); }
.form-textarea { min-height: 100px; resize: vertical; line-height: 1.7; }
.form-row { display: flex; gap: 16px; }
.form-row .form-group { flex: 1; }

/* 抽屉 */
.drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
}
.drawer-overlay.show { display: block; }
.drawer {
  position: fixed;
  top: 0; right: -500px;
  width: 500px;
  height: 100%;
  background: #fff;
  z-index: 101;
  transition: right 0.3s;
  overflow-y: auto;
  padding: 32px;
}
.drawer.show { right: 0; }
.drawer-close {
  position: absolute;
  top: 20px; right: 24px;
  font-size: 20px;
  color: var(--text-muted);
  cursor: pointer;
}
.drawer-title {
  font-size: 20px;
  font-weight: 400;
  margin-bottom: 24px;
  padding-right: 40px;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--text);
  color: #fff;
  padding: 10px 24px;
  font-size: 13px;
  z-index: 200;
  opacity: 0;
  transition: opacity 0.3s;
}
.toast.show { opacity: 1; }

/* ===== AI 对话 ===== */
.chat-container {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 0px);
}
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 32px 56px;
  max-width: 760px;
  margin: 0 auto;
  width: 100%;
}
.chat-msg {
  margin-bottom: 24px;
  max-width: 85%;
}
.chat-msg.user { margin-left: auto; }
.chat-msg.assistant { margin-right: auto; }
.chat-bubble {
  padding: 14px 18px;
  font-size: 13px;
  line-height: 1.8;
  white-space: pre-wrap;
}
.chat-msg.user .chat-bubble {
  background: var(--text);
  color: #fff;
}
.chat-msg.assistant .chat-bubble {
  background: #fff;
  border: 1px solid var(--border);
  color: var(--text);
}
.chat-time {
  font-size: 10px;
  color: var(--text-muted);
  margin-top: 4px;
}
.chat-msg.user .chat-time { text-align: right; }
.chat-input-area {
  border-top: 1px solid var(--border);
  padding: 20px 56px;
  background: #fff;
}
.chat-input-wrap {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  gap: 12px;
  align-items: flex-end;
}
.chat-input {
  flex: 1;
  padding: 12px 16px;
  border: 1px solid var(--border);
  background: var(--bg);
  font-size: 13px;
  resize: none;
  min-height: 44px;
  max-height: 120px;
  outline: none;
  line-height: 1.6;
}
.chat-input:focus { border-color: var(--text); }
.chat-send {
  padding: 12px 24px;
  background: var(--text);
  color: #fff;
  font-size: 13px;
  border: none;
  cursor: pointer;
}
.chat-send:disabled { opacity: 0.4; cursor: not-allowed; }
.chat-hint {
  max-width: 760px;
  margin: 8px auto 0;
  font-size: 11px;
  color: var(--text-muted);
}

/* ===== 待办 ===== */
.todo-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}
.todo-check {
  width: 18px; height: 18px;
  border: 1px solid var(--text-muted);
  cursor: pointer;
  flex-shrink: 0;
  margin-top: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #fff;
}
.todo-check.checked { background: var(--text); border-color: var(--text); }
.todo-content { flex: 1; }
.todo-title { font-size: 14px; }
.todo-title.done { text-decoration: line-through; color: var(--text-muted); }
.todo-meta { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
.todo-delete {
  color: var(--text-muted);
  font-size: 12px;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.2s;
}
.todo-item:hover .todo-delete { opacity: 1; }
.add-bar {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
}
.add-bar input {
  flex: 1;
  padding: 10px 14px;
  border: 1px solid var(--border);
  background: #fff;
  font-size: 13px;
  outline: none;
}
.add-bar input:focus { border-color: var(--text); }

/* ===== 运动 ===== */
.exercise-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
}
.exercise-today {
  text-align: center;
  padding: 32px;
  border: 1px solid var(--border);
  background: #fff;
  margin-bottom: 24px;
}
.exercise-status {
  font-size: 18px;
  font-weight: 300;
  margin-bottom: 8px;
}
.exercise-date { font-size: 12px; color: var(--text-muted); }
.exercise-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}
.exercise-stat {
  text-align: center;
  padding: 20px;
  border: 1px solid var(--border);
  background: #fff;
}
.exercise-stat-num { font-size: 24px; font-weight: 300; }
.exercise-stat-label { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
.exercise-list .card { cursor: default; }

/* ===== 朋友 + 关系图谱 ===== */
.friends-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--border);
}
.friends-tab {
  padding: 10px 20px;
  font-size: 13px;
  color: var(--text-muted);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}
.friends-tab.active { color: var(--text); border-bottom-color: var(--red); }
.graph-container {
  width: 100%;
  height: 500px;
  border: 1px solid var(--border);
  background: #fff;
  position: relative;
  overflow: hidden;
}
.graph-container svg { width: 100%; height: 100%; }
.graph-node { cursor: pointer; }
.graph-node circle { transition: r 0.2s; }
.graph-node:hover circle { r: 28; }
.graph-node text {
  font-size: 11px;
  fill: var(--text);
  text-anchor: middle;
  pointer-events: none;
}
.graph-line { stroke: var(--border); stroke-width: 1; }
.graph-legend {
  position: absolute;
  bottom: 16px;
  left: 16px;
  font-size: 11px;
  color: var(--text-muted);
}
.friend-draft { opacity: 0.6; }
.friend-draft .card-title::after {
  content: ' 待确认';
  font-size: 10px;
  color: var(--red);
  margin-left: 8px;
}

/* ===== 设置 ===== */
.settings-section {
  margin-bottom: 40px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--border);
}
.settings-section:last-child { border-bottom: none; }
.settings-section h3 {
  font-size: 14px;
  font-weight: 500;
  margin-bottom: 20px;
  letter-spacing: 1px;
}
.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid var(--hover);
}
.settings-item:last-child { border-bottom: none; }
.settings-label { font-size: 13px; }
.settings-desc { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
.settings-control { width: 200px; }
.settings-control input, .settings-control select {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid var(--border);
  font-size: 13px;
  outline: none;
  background: #fff;
}

/* 滚动条 */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ddd; }
::-webkit-scrollbar-thumb:hover { background: #bbb; }

/* 响应式 */
@media (max-width: 768px) {
  .sidebar { width: 60px; }
  .sidebar-logo p, .nav-item span, .nav-group-title, .sidebar-footer { display: none; }
  .page { padding: 32px 24px; }
  .splash { padding: 40px 24px; }
  .splash-greeting { font-size: 24px; }
  .drawer { width: 100%; right: -100%; }
}
</style>
</head>
<body>
<div class="app">
  <!-- 侧边栏 -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <h1>OneDay</h1>
      <p>一 日</p>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-group">
        <div class="nav-group-title">今日</div>
        <div class="nav-item active" data-view="splash"><span>开屏</span><span class="dot"></span></div>
      </div>
      <div class="nav-group">
        <div class="nav-group-title">工作</div>
        <div class="nav-item" data-view="todos"><span>待办</span><span class="dot"></span></div>
        <div class="nav-item" data-view="projects"><span>重要事件</span><span class="dot"></span></div>
      </div>
      <div class="nav-group">
        <div class="nav-group-title">生活</div>
        <div class="nav-item" data-view="inspirations"><span>灵感</span><span class="dot"></span></div>
        <div class="nav-item" data-view="exercise"><span>运动</span><span class="dot"></span></div>
        <div class="nav-item" data-view="friends"><span>朋友</span><span class="dot"></span></div>
      </div>
      <div class="nav-group">
        <div class="nav-group-title">对话</div>
        <div class="nav-item" data-view="chat"><span>AI 对话</span><span class="dot"></span></div>
      </div>
      <div class="nav-group">
        <div class="nav-group-title">系统</div>
        <div class="nav-item" data-view="settings"><span>设置</span></div>
      </div>
    </nav>
    <div class="sidebar-footer">v3.0 · 一日</div>
  </aside>

  <!-- 主内容区 -->
  <main class="main">
    <!-- 开屏页 -->
    <div class="view active" id="view-splash">
      <div class="splash" id="splash-bg">
        <div class="splash-content">
          <div class="splash-date" id="splash-date"></div>
          <div class="splash-greeting" id="splash-greeting"></div>
          <div class="splash-quote" id="splash-quote"></div>
          <div class="splash-stats" id="splash-stats"></div>
          <div class="splash-actions">
            <button class="btn btn-primary" onclick="navigate('chat')">跟 AI 聊聊</button>
            <button class="btn" onclick="navigate('todos')">查看待办</button>
          </div>
        </div>
      </div>
    </div>

    <!-- 待办 -->
    <div class="view" id="view-todos">
      <div class="page">
        <div class="page-header">
          <div class="page-eyebrow">TO DO</div>
          <h2 class="page-title">待办</h2>
          <p class="page-desc">跟 AI 说"我要做什么"，它会自动帮你记下来。</p>
        </div>
        <div class="add-bar">
          <input type="text" id="todo-input" placeholder="添加一个待办..." onkeydown="if(event.key==='Enter')addTodo()">
          <button class="btn btn-sm btn-primary" onclick="addTodo()">添加</button>
        </div>
        <div id="todo-list"></div>
      </div>
    </div>

    <!-- 重要事件 -->
    <div class="view" id="view-projects">
      <div class="page">
        <div class="page-header">
          <div class="page-eyebrow">PROJECTS</div>
          <h2 class="page-title">重要事件</h2>
          <p class="page-desc">正在跟进的项目、事件、目标。不限于工作，生活中的大事也可以记。</p>
        </div>
        <div style="margin-bottom:24px;">
          <button class="btn btn-sm btn-primary" onclick="openProjectDrawer()">+ 新增事件</button>
        </div>
        <div id="project-list"></div>
      </div>
    </div>

    <!-- 灵感 -->
    <div class="view" id="view-inspirations">
      <div class="page">
        <div class="page-header">
          <div class="page-eyebrow">INSPIRATIONS</div>
          <h2 class="page-title">灵感</h2>
          <p class="page-desc">想到什么随手记，跟 AI 说也行。灵感这东西，记下来就跑不掉。</p>
        </div>
        <div class="add-bar">
          <input type="text" id="insp-input" placeholder="记录一个灵感..." onkeydown="if(event.key==='Enter')addInspiration()">
          <button class="btn btn-sm btn-primary" onclick="addInspiration()">记录</button>
        </div>
        <div id="insp-list"></div>
      </div>
    </div>

    <!-- 运动 -->
    <div class="view" id="view-exercise">
      <div class="page">
        <div class="page-header">
          <div class="page-eyebrow">EXERCISE</div>
          <h2 class="page-title">运动</h2>
          <p class="page-desc">每天动一动。没打卡的话，晚上 AI 会提醒你。</p>
        </div>
        <div class="exercise-today">
          <div class="exercise-status" id="exercise-today-status">今天还没运动</div>
          <div class="exercise-date" id="exercise-today-date"></div>
          <div style="margin-top:16px;">
            <button class="btn btn-sm btn-primary" onclick="checkInExercise()">打卡今天</button>
          </div>
        </div>
        <div class="exercise-stats">
          <div class="exercise-stat">
            <div class="exercise-stat-num" id="stat-week">0</div>
            <div class="exercise-stat-label">本周次数</div>
          </div>
          <div class="exercise-stat">
            <div class="exercise-stat-num" id="stat-month">0</div>
            <div class="exercise-stat-label">本月次数</div>
          </div>
          <div class="exercise-stat">
            <div class="exercise-stat-num" id="stat-total">0</div>
            <div class="exercise-stat-label">累计次数</div>
          </div>
        </div>
        <h3 style="font-size:14px;font-weight:500;margin-bottom:16px;">最近记录</h3>
        <div id="exercise-list" class="exercise-list"></div>
      </div>
    </div>

    <!-- 朋友 -->
    <div class="view" id="view-friends">
      <div class="page">
        <div class="page-header">
          <div class="page-eyebrow">FRIENDS</div>
          <h2 class="page-title">朋友</h2>
          <p class="page-desc">AI 会从对话中草记人名，你来完善信息。关系图谱展示人与人的连接。</p>
        </div>
        <div class="friends-tabs">
          <div class="friends-tab active" data-tab="list" onclick="switchFriendsTab('list')">人物列表</div>
          <div class="friends-tab" data-tab="graph" onclick="switchFriendsTab('graph')">关系图谱</div>
        </div>
        <div id="friends-list-view">
          <div style="margin-bottom:24px;">
            <button class="btn btn-sm btn-primary" onclick="openFriendDrawer()">+ 添加朋友</button>
          </div>
          <div id="friend-list"></div>
        </div>
        <div id="friends-graph-view" style="display:none;">
          <div class="graph-container" id="graph-container">
            <svg id="graph-svg"></svg>
            <div class="graph-legend">拖拽节点 · 点击查看详情</div>
          </div>
